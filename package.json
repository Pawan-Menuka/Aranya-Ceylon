{
  "name": "aranya-ceylon",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:backend": "pnpm --filter @aranya/backend dev",
    "build:backend": "pnpm --filter @aranya/backend build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "workspacePackages": [
      "backend",
      "frontend",
      "shared"
    ],
    "ignoredBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "vitest": "^4.1.1"
  }
}