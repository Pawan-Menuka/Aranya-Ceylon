# Backend REST API base (Express + Prisma). Dev default below.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional SERVER-ONLY browser BFF visitor identity signature. Set identical
# random >=32-character secret on Next and API ONLY behind controlled ingress:
# ingress overwrites x-aranya-verified-client-ip; Next is loopback/firewalled.
# Never NEXT_PUBLIC_, never accept that source header on a public Next port.
# Unset preserves existing proxy behavior. Weak secret/invalid source fails closed.
BFF_CLIENT_IP_SECRET=

# Optional SERVER-ONLY market verifier for the shared public Data Cache.
# Set this to the same value as backend COOKIE_SECRET. Never prefix NEXT_PUBLIC_.
# Without it, public reads forward only x-market and remain uncached.
MARKET_COOKIE_SECRET=

# Public origin of THIS app — used for canonical URLs, sitemap, OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CDN / R2 base for hero frames + product photography. Leave blank to use
# the bundled simulated still + on-brand SpicePhoto placeholders.
NEXT_PUBLIC_ASSETS_URL=

# Shared with the backend: authenticates public data/path invalidation batches.
REVALIDATION_SECRET=change-me

# Offline/demo fallbacks (demo admin console, demo sign-in, demo data). Leave
# UNSET/false in production — 'true' lets anyone into the admin console when the
# backend is unreachable. Enable only for local/preview review.
NEXT_PUBLIC_ENABLE_DEMO=false

# LKR→USD rate for the admin console's USD-equivalent display (default 300).
# Keep equal to the backend's LKR_USD_RATE so admin figures agree.
NEXT_PUBLIC_LKR_USD_RATE=300

# Low-stock threshold for the admin Products page (default 10). Keep equal to
# the backend's LOW_STOCK_THRESHOLD so the Products page and the Dashboard's
# Low Stock panel agree on which items need restocking.
NEXT_PUBLIC_LOW_STOCK_THRESHOLD=10

# Optional first-party Web Vitals. Default off; no provider/credential required.
# These are SERVER-ONLY flags. Origin must equal the browser's public origin.
# Enabling sends bounded anonymous public-route metrics to /api/performance.
PERFORMANCE_TELEMETRY_ENABLED=false
PERFORMANCE_TELEMETRY_ORIGIN=
PERFORMANCE_TELEMETRY_SAMPLE_RATE=0.1
# Per Next worker, global (no IP/session tracking), clamped to 1..600.
PERFORMANCE_TELEMETRY_REQUESTS_PER_MINUTE=120

# Optional server-side logical public-read duration/cache-policy logs. Never
# logs resource keys, cookies, queries or IDs. Policy is not a cache-hit flag.
PUBLIC_READ_METRICS_ENABLED=false
PUBLIC_READ_METRICS_SAMPLE_RATE=0.1
