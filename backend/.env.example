# Server
PORT=4000
NODE_ENV=development

# Dev-only routes (POST /dev/seed-catalog). NEVER set to 'true' in production.
ENABLE_DEV_ROUTES=true

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Proxy / client-IP resolution (affects rate limiting + audit-log IPs).
# TRUST_PROXY = number of proxy hops in front of the app: Railway alone = 1,
# with Cloudflare in front = 2.
TRUST_PROXY=1
# Set to 'true' once the API is fronted by Cloudflare AND the origin only accepts
# Cloudflare traffic — keys rate limiting / audit on the CF-Connecting-IP header.
TRUST_CLOUDFLARE=false

# Database (added in Step 2)
DATABASE_URL=

# JWT (access tokens only — refresh tokens are opaque strings, no secret needed)
# Must be at least 32 characters in production — the server refuses to boot
# otherwise (see src/config/env.ts). Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=

# Payment mode: anything other than 'live' = stub (no real gateways/keys needed;
# checkout returns gateway:'stub' and is confirmed via POST /checkout/stub/complete).
# Set to 'live' once real Stripe + PayHere credentials are in place.
# NOTE: in production the server REFUSES to boot unless PAYMENTS_MODE=live —
# stub mode there would let anyone mark orders PAID for free (see src/config/env.ts).
PAYMENTS_MODE=stub

# Stripe (added in Step 5) — required only when PAYMENTS_MODE=live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary (added in Step 4)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend email (added in Step 4)
RESEND_API_KEY=

# HMAC key for the signed market cookie. Must be at least 32 characters in
# production — the server refuses to boot otherwise. Generate: openssl rand -hex 32
COOKIE_SECRET=your_64_byte_hex_secret_here

# Seed admin credentials. SEED_ADMIN_PASSWORD is REQUIRED to seed in production
# (no default password ships in source). Locally an insecure default is used.
SEED_ADMIN_EMAIL=admin@aranyaceylon.com
SEED_ADMIN_PASSWORD=

# PayHere (local market)
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_MODE=sandbox   # change to 'live' in production

# Stripe (international market)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Frontend URLs (for PayHere redirect)
FRONTEND_URL=http://localhost:3000

# Public origin of this API — used to build the PayHere notify_url.
# REQUIRED when PAYMENTS_MODE=live (unset would post webhooks to localhost).
API_URL=http://localhost:4000

# Email (Resend)
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=orders@aranyaceylon.com

# Low stock alert threshold
LOW_STOCK_THRESHOLD=10

# Next.js ISR revalidation secret (set same value in frontend .env)
REVALIDATION_SECRET=your_revalidation_secret_here