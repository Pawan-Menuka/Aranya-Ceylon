        "@types/multer": "^2.1.0",
        "@types/node": "^20.14.0",
        "@types/node-cron": "^3.0.11",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^8.57.2",
        "@typescript-eslint/parser": "^8.57.2",
        "eslint": "^10.1.0",
        "prisma": "^7.5.0",
        "tsx": "^4.15.0",
        "typescript": "^5.5.0",
        "vitest": "^4.1.1"
