        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "eslint": "^10.1.0",
        "prisma": "^7.9.1",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
