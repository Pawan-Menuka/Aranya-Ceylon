{
    "name": "@aranya/backend",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc --project tsconfig.build.json",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vitest run",
        "seed:catalog": "tsx prisma/seed-catalog.ts"
    },
    "dependencies": {
        "@aranya/shared": "workspace:*",
        "@neondatabase/serverless": "^1.1.0",
        "@node-rs/bcrypt": "^1.10.7",
        "@paralleldrive/cuid2": "^3.3.0",
        "@prisma/adapter-neon": "^7.8.0",
        "@prisma/client": "^7.5.0",
        "cloudinary": "^2.9.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^4.19.2",
        "express-rate-limit": "^8.5.2",
        "helmet": "^7.1.0",
        "jose": "^6.2.2",
        "multer": "^2.2.0",
        "node-cron": "^4.2.1",
        "resend": "^6.9.4",
        "stripe": "^21.0.0",
        "ws": "^8.21.0",
