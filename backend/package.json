        "@prisma/adapter-neon": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "cloudinary": "^2.10.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^8.6.2",
        "helmet": "^7.1.0",
        "jose": "^6.2.8",
        "multer": "^2.2.0",
        "node-cron": "^4.6.0",
