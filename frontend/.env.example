# Base URL of the Aranya backend API (server-side fetches + client calls).
# Local dev: the Express API. Prod: same parent domain as the app (e.g. https://api.aranyaceylon.com).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Hostname serving hero frames + product images (Cloudflare R2 custom domain).
# Allow-listed for next/image. Leave unset in local dev to use local/placeholder assets.
# Example: cdn.aranyaceylon.com
NEXT_PUBLIC_ASSETS_HOST=

# Base URL for static assets (hero frame sequence, etc.). Falls back to "" (app-relative).
# Example: https://cdn.aranyaceylon.com
NEXT_PUBLIC_ASSETS_URL=
